# A **full-form** document — level 2. The y-strings defer their values, so
# reading this needs the resolver.
#
# `python -m yapyon expand` resolves them and emits a **record**: level 1,
# loadable by an implementation that has no resolver at all. That crossing
# is the point of this file. Compare registry.ypy, which starts as a record,
# and gateway.ypy, which carries a `yt` and so cannot cross.

name: "gateway"
version: 3.10

paths:
  root: "/srv/gateway"
  logs: y"{root}/logs"                 # nearest wins: sibling `root`
  banner: y"{name} v{version}"         # outer scope; splices the *lexeme*,
                                     # so 3.10 stays 3.10 and not 3.1
